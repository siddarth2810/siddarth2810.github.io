---
import Layout from "../../layouts/Layout.astro";
import ReadsList from "../../components/ReadsList";

const googleSheetId = import.meta.env.PUBLIC_GOOGLE_SHEET_ID ?? "";
---

<Layout title="Siddarth Gundu • reads">
  <div class="max-w-2xl">
    <h1 class="text-primary font-serif text-[2.5rem] tracking-tight">Reads</h1>
    <h2 class="text-title text-base font-medium tracking-tight">
      Collection books, articles and videos I really loved or found useful<br />
      Note: I haven't finished some of these books yet
    </h2>

    <ReadsList client:load googleSheetId={googleSheetId} />
  </div>
</Layout>
