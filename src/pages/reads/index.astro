---
import Layout from "../../layouts/Layout.astro";
import ReadsList from "../../components/ReadsList";

const googleSheetId = import.meta.env.PUBLIC_GOOGLE_SHEET_ID ?? "";
---

<Layout title="Siddarth Gundu • reads">
  <div class="reads-page max-w-2xl">
    <h1 class="reads-page__title">Reads</h1>
    <h2 class="reads-page__intro">
      Collection books, articles and videos I really loved or found useful.
      Note: I haven't finished some of these books yet.
    </h2>

    <ReadsList client:load googleSheetId={googleSheetId} />
  </div>
</Layout>
