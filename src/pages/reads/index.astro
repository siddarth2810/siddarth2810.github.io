---
import Layout from "../../layouts/Layout.astro";
import { fetchLearningItems } from "../../util/google-sheet";

const items = await fetchLearningItems("learning");

//console.log(items)

type GroupedItems = Record<
  string,
  {
    read: Array<{ title: string; link: string }>;
    lecture: Array<{ title: string; link: string }>;
  }
>;

const grouped = items.reduce<GroupedItems>((acc, item) => {
  if (!acc[item.category]) {
    acc[item.category] = {
      read: [],
      lecture: [],
    };
  }

  acc[item.category][item.subtype].push({
    title: item.title,
    link: item.link,
  });

  return acc;
}, {});

const orderedCategories = Object.keys(grouped).sort((a, b) =>
  a.localeCompare(b),
);
---

<Layout title="Siddarth Gundu • reads">
  <div class="max-w-2xl">
    <h1 class="text-primary font-serif text-[2.5rem] tracking-tight">Reads</h1>
    <h2 class="text-title text-base font-medium tracking-tight">
      Collection books, articles and videos I really loved or found useful<br />
      Note: I haven't finished some of these books yet
    </h2>

    <div class="pt-3 flex-col gap-2">
      {
        orderedCategories.map((category) => (
          <section>
            <h2 class="font-serif text-black mt-4 text-base md:text-lg">
              {category}
            </h2>

            {grouped[category].read.length > 0 && (
              <div class="mt-2">
                <p class="text-md text-black ">Reads :</p>

                <ul class="">
                  {grouped[category].read.map((item) => (
                    <li>
                      <a
                        href={item.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="underline-offset-2 hover:underline"
                      >
                        {item.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {grouped[category].lecture.length > 0 && (
              <div class="mt-4">
                <p class="text-md text-black ">Videos :</p>

                <ul class="">
                  {grouped[category].lecture.map((item) => (
                    <li>
                      <a
                        href={item.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="underline-offset-2 hover:underline"
                      >
                        {item.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </section>
        ))
      }
    </div>
  </div>
</Layout>
