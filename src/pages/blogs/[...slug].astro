---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { formatPostDate, getPostSummary, getReadingTime } from "../../util/blog";

type BlogPost = CollectionEntry<"blog">;

export async function getStaticPaths() {
  const posts = await getCollection(
    "blog",
    (post: BlogPost) => !post.data.draft,
  );

  return posts.map((post: BlogPost) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { Content } = await post.render();
const minutes = getReadingTime(post);
---

<Layout
  title={`${post.data.title} • Siddarth Gundu`}
  description={getPostSummary(post)}
  type="article"
  publishedAt={post.data.pubDate}
>
  <div class="blog-post-shell">
    <article class="blog-post">
      <header class="blog-post__header" id="blog-hero">
        <h1 class="type-m-600">{post.data.title}</h1>
        <p class="blog-post__meta type-s-500 type-tnum">
          Siddarth Gundu - {formatPostDate(post.data.pubDate)} · {minutes} min read
        </p>
        {
          post.data.description && (
            <p class="blog-post__description type-m-500">
              {post.data.description}
            </p>
          )
        }
      </header>

      <div class="blog-prose type-prose">
        <Content />
      </div>
    </article>

    <button
      aria-label="Back to top"
      class="blog-post__top"
      data-show="false"
      id="to-top-btn"
      type="button"
    >
      <svg
        aria-hidden="true"
        fill="none"
        focusable="false"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M4.5 15.75l7.5-7.5 7.5 7.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>
  </div>

  <script>
    import { setupBlogTopButton } from "../../util/blog";

    setupBlogTopButton();
  </script>
</Layout>
