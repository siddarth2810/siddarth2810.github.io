---
import Layout from "../../layouts/Layout.astro";
import { RiArrowRightUpLine } from "react-icons/ri";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import externalBlogs from "../../constants/blogs.json";
import {
  formatPostDate,
  getPostSummary,
  getReadingTime,
  sortPostsByDate,
} from "../../util/blog";
import { getHostname, withBase } from "../../util/url";

type BlogPost = CollectionEntry<"blog">;

const posts = sortPostsByDate(
  await getCollection("blog", (post: BlogPost) => !post.data.draft),
);

const externalPosts = externalBlogs.map((blog) => ({
  ...blog,
  source: getHostname(blog.link),
}));
---

<Layout title="Siddarth Gundu">
  <section class="blog-index">
    <header class="blog-index__header">
      <h1>Writings</h1>
      <p>Notes on systems, open source, infrastructure.</p>
    </header>

    <div class="blog-list" aria-label="Local blog posts">
      {
        posts.map((post) => {
          const minutes = getReadingTime(post);
          const readingLength = `${minutes} minute${minutes === 1 ? "" : "s"} long`;

          return (
            <article class="blog-card">
              <a href={withBase(`blogs/${post.slug}`)} class="blog-card__link">
                <h2>{post.data.title}</h2>
                <p class="blog-card__meta">
                  {formatPostDate(post.data.pubDate)} · About {readingLength}
                </p>
                <p class="blog-card__summary">{getPostSummary(post)}</p>
                {post.data.tags.length > 0 && (
                  <ul class="blog-card__tags" aria-label="Tags">
                    {post.data.tags.map((tag: string) => (
                      <li>{tag}</li>
                    ))}
                  </ul>
                )}
              </a>
            </article>
          );
        })
      }
    </div>

    <section class="external-writing" aria-labelledby="external-writing-title">
      <div class="blog-list blog-list--external">
        {
          externalPosts.map((blog) => (
            <article class="blog-card">
              <a
                href={blog.link}
                target="_blank"
                rel="noopener noreferrer"
                class="blog-card__link blog-card__link--external"
              >
                <div class="blog-card__title-row">
                  <h3>{blog.title}</h3>
                  <RiArrowRightUpLine className="blog-card__external-icon" />
                </div>
                <p class="blog-card__meta">Published on {blog.source}</p>
              </a>
            </article>
          ))
        }
      </div>
    </section>
  </section>
</Layout>
