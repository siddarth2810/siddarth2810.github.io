---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page not found • Siddarth Gundu"
  description="That page doesn't exist."
>
  <div class="max-w-2xl">
    <h1 class="type-h1 m-0">Page not found</h1>
    <p class="type-m-500 mt-4 text-muted">
      That link is broken or the page has moved.
    </p>
    <p class="type-m-500 mt-6">
      <a href="/">Back to the homepage</a>
    </p>
  </div>
</Layout>
