---
import Layout from "../layouts/Layout.astro";
import { getEntry } from "astro:content";

const logEntry = await getEntry("opensource_log", "opensource-log");
const { Content } = await logEntry.render();
---

<Layout
  title={`${logEntry.data.title} • Siddarth Gundu`}
  description="Track Siddarth Gundu's open source patches and contributions to Cortex, Vortex, the Linux kernel, Open Library, and nix.dev."
>
  <div class="blog-post-shell">
    <article class="blog-post">
      <header class="blog-post__header">
        <h1 class="type-m-600">{logEntry.data.title}</h1>
        {
          logEntry.data.description && (
            <p class="blog-post__description type-m-500">
              {logEntry.data.description}
            </p>
          )
        }
      </header>

      <div class="blog-prose type-prose">
        <Content />
      </div>
    </article>
  </div>
</Layout>
