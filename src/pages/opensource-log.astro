---
import Layout from "../layouts/Layout.astro";
import { getEntry } from "astro:content";

const logEntry = await getEntry("opensource_log", "opensource-log");
const { Content } = await logEntry.render();
---

<Layout title={`${logEntry.data.title} • Siddarth Gundu`}>
  <div class="blog-post-shell">
    <article class="blog-post">
      <header class="blog-post__header">
        <h1>{logEntry.data.title}</h1>
        {logEntry.data.description && (
          <p class="blog-post__description">{logEntry.data.description}</p>
        )}
      </header>

      <div class="blog-prose">
        <Content />
      </div>
    </article>
  </div>
</Layout>

<style>
  .blog-post-shell {
    width: min(100ch, 100%);
    margin: 0 auto;
  }

  .blog-post {
    min-width: 0;
    overflow-wrap: break-word;
  }

  .blog-post__header {
    margin: 0 0 1.55rem;
  }

  .blog-post__header h1 {
    margin: 0;
    color: var(--fg);
    font-family: var(--font-heading);
    font-size: clamp(2.4rem, 7vw, 3.4rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .blog-post__description {
    max-width: 42rem;
    margin: 1.15rem 0 0;
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.55;
    text-wrap: pretty;
  }

  .blog-prose {
    color: var(--fg);
    font-family: var(--font-body);
    font-size: 1.25rem;
    line-height: 1.75;
  }

  .blog-prose :global(*) {
    overflow-wrap: break-word;
  }

  .blog-prose :global(p) {
    margin: 1.05rem 0;
    text-wrap: pretty;
  }

  .blog-prose :global(h1),
  .blog-prose :global(h2),
  .blog-prose :global(h3),
  .blog-prose :global(h4),
  .blog-prose :global(h5),
  .blog-prose :global(h6) {
    position: relative;
    margin: 2.4rem 0 0.9rem;
    color: var(--fg);
    font-family: var(--font-heading);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .blog-prose :global(h2) {
    font-size: 1.5em;
    line-height: 1.3333333;
  }

  .blog-prose :global(h3) {
    font-size: 1.25em;
    line-height: 1.6;
  }

  .blog-prose :global(a) {
    border-bottom: 2px dotted rgba(var(--color-secondary-rgb), 0.68);
    color: var(--color-secondary);
    text-decoration: none;
    transition:
      border-color 120ms ease,
      color 120ms ease,
      filter 120ms ease;
  }

  .blog-prose :global(a:hover),
  .blog-prose :global(a:focus-visible) {
    border-bottom-style: solid;
    border-color: var(--color-secondary);
    filter: brightness(1.08);
  }

  .blog-prose :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    margin: 1.65rem 0;
    border-collapse: collapse;
  }

  .blog-prose :global(th),
  .blog-prose :global(td) {
    border-right: 1px solid rgba(var(--color-primary-rgb), 0.12);
    border-bottom: 1px solid rgba(var(--color-primary-rgb), 0.12);
    padding: 0.55rem 0.8rem;
    text-align: left;
  }

  .blog-prose :global(thead),
  .blog-prose :global(tr:nth-child(even)) {
    background: var(--surface);
  }

  @media (max-width: 640px) {
    .blog-post__header {
      margin-bottom: 1.45rem;
    }

    .blog-post__header h1 {
      font-size: clamp(2.05rem, 11vw, 2.55rem);
      line-height: 1.08;
    }

    .blog-prose {
      font-size: 1.13rem;
      line-height: 1.64;
    }

    .blog-prose :global(p) {
      text-align: justify;
      word-spacing: -0.025em;
      letter-spacing: -0.01em;
    }

    .blog-prose :global(table) {
      font-size: 0.9rem;
    }
  }

  @media (max-width: 420px) {
    .blog-post__header {
      margin-bottom: 1.2rem;
    }

    .blog-post__header h1 {
      font-size: clamp(1.85rem, 11vw, 2.25rem);
    }

    .blog-post__description {
      font-size: 0.98rem;
      line-height: 1.52;
    }

    .blog-prose {
      font-size: 1.04rem;
      line-height: 1.62;
    }

    .blog-prose :global(h1),
    .blog-prose :global(h2),
    .blog-prose :global(h3),
    .blog-prose :global(h4),
    .blog-prose :global(h5),
    .blog-prose :global(h6) {
      margin-top: 2rem;
    }

    .blog-prose :global(h2) {
      font-size: 1.45rem;
    }

    .blog-prose :global(blockquote) {
      padding-left: 0.85rem;
    }

    .blog-prose :global(pre) {
      margin: 1.2rem 0;
      padding: 0.8rem;
    }

    .blog-prose :global(table) {
      font-size: 0.9rem;
    }
  }
</style>
