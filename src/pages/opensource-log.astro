---
import Layout from "../layouts/Layout.astro";
import { getEntry } from "astro:content";

const logEntry = await getEntry("opensource_log", "opensource-log");
const { Content } = await logEntry.render();
---

<Layout title={`${logEntry.data.title} • Siddarth Gundu`}>
  <div class="blog-post-shell">
    <article class="blog-post">
      <header class="blog-post__header">
        <h1>{logEntry.data.title}</h1>
        {
          logEntry.data.description && (
            <p class="blog-post__description">{logEntry.data.description}</p>
          )
        }
      </header>

      <div class="blog-prose">
        <Content />
      </div>
    </article>
  </div>
</Layout>
