---
import Layout from "../layouts/Layout.astro";
import socialData from "../constants/socials.json";
import projects from "../constants/projects.json";
import writingPostsData from "../constants/blogs.json";
import ProjectCard from "../components/ui/ProjectCard.astro";
import CommunityGrid from "../components/CommunityGrid.astro";
import Icon from "../components/ui/Icon.astro";
import { getHostname } from "../util/url";

const socials = socialData;
const featuredProjects = projects.slice(0, 3);
const writingPosts = writingPostsData.slice(0, 3).map((post) => ({
  ...post,
  source: getHostname(post.link),
}));
---

<Layout
  title="Siddarth Gundu • Software Engineer & Builder"
  description="Siddarth Gundu is a software engineer, builder, and habitual tinkerer. Explore his projects, engineering work, open source contributions, and writing."
>
  <div>
    <h1 class="type-display m-0 text-balance text-primary">Siddarth Gundu</h1>
    <div class="socials">
      {
        socials.map((social) => (
          <a
            href={social.url}
            target={social.target}
            rel={social.target === "_blank" ? "noopener noreferrer" : undefined}
            class="socials__link group"
          >
            <img
              src={`/icons/${social.icon}.svg`}
              alt={`${social.name} icon`}
              class="socials__icon"
            />
            <span class="socials__label">{social.name}</span>
            <Icon name="arrow-up-right" class="socials__arrow" />
          </a>
        ))
      }
    </div>

    <p class="about-copy type-m-500 m-0 mt-6">
            Hi there,I am a builder and habitual tinkerer.
            I enjoy solving problems and understanding how software works under the hood, often by building things from scratch.
    </p>
  </div>

  <section
    class="home-section"
    id="projects"
    aria-labelledby="projects-heading"
  >
    <header class="home-section__header">
      <div class="home-section__intro">
        <h2
          id="projects-heading"
          class="section-heading type-h2 m-0 text-title"
        >
          Projects
        </h2>
        <p class="section-copy type-s-500 m-0 text-muted">
          Projects I've shipped.
        </p>
      </div>

      <a
        class="home-section__action section-action type-s-500"
        href="/projects/"
      >
        <span>View all projects</span>
        <Icon
          name="arrow-up-right"
          class="section-action__icon h-4 w-4 shrink-0"
        />
      </a>
    </header>

    <ul class="home-section__list" aria-label="Featured projects">
      {
        featuredProjects.map((project) => (
          <li>
            <ProjectCard project={project} showDetails={false} showTech={false} />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="home-section" id="writing" aria-labelledby="writing-heading">
    <header class="home-section__header">
      <div class="home-section__intro">
        <h2 id="writing-heading" class="section-heading type-h2 m-0 text-title">
          Writing
        </h2>
        <p class="section-copy type-s-500 m-0 text-muted">
          Articles on engineering and technology.
        </p>
      </div>

      <a class="home-section__action section-action type-s-500" href="/blogs/">
        <span>View all writings</span>
        <Icon
          name="arrow-up-right"
          class="section-action__icon h-4 w-4 shrink-0"
        />
      </a>
    </header>

    <ul class="home-section__list" aria-label="Featured writing">
      {
        writingPosts.map((post) => (
          <li>
            <a
              class="writing-card"
              href={post.link}
              target="_blank"
              rel="noopener noreferrer"
            >
              <h3 class="type-m-600 m-0">{post.title}</h3>
              <span class="writing-card__source type-s-500">
                {post.source}
                <Icon
                  name="arrow-up-right"
                  class="writing-card__external-icon h-4 w-4 shrink-0"
                />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <CommunityGrid />
</Layout>
