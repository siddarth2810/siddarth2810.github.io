---
import Layout from "../../layouts/Layout.astro";
import ProjectCard from "../../components/ui/ProjectCard.astro";
import projects from "../../constants/projects.json";
---

<Layout title="Siddarth Gundu • projects">
        <section class="project-page">
                <header class="project-page__header">
                        <h1>Projects & Experiments</h1>
                        <p>A List of projects and learning experiments</p>
                </header>

                <div class="projects-grid" aria-label="Projects">
                        {
                                projects.map((project) => (
                                        <ProjectCard project={project} />
                                ))
                        }
                </div>
        </section>
</Layout>

<style>
        .project-page {
                width: 100%;
        }

        .project-page__header {
                max-width: 43rem;
                margin-bottom: 1.5rem;
        }

        .project-page__header h1 {
                margin: 0;
                color: var(--ink);
                font-family: var(--font-heading);
                font-size: 2.65rem;
                font-weight: 600;
                line-height: 1.04;
                letter-spacing: 0;
                text-wrap: balance;
        }

        .project-page__header p:last-child {
                margin: 0.65rem 0 0;
                color: var(--muted);
                font-size: 1rem;
                font-weight: 400;
                line-height: 1.58;
                text-wrap: pretty;
        }

        @media (max-width: 640px) {
                .project-page__header {
                        margin-bottom: 1.25rem;
                }

                .project-page__header h1 {
                        font-size: 2.25rem;
                }
        }

        @media (max-width: 420px) {
                .project-page__header h1 {
                        font-size: 2rem;
                        line-height: 1.08;
                }

                .project-page__header p:last-child {
                        font-size: 0.94rem;
                        line-height: 1.55;
                }
        }
</style>
