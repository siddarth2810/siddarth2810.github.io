---
import Layout from "../../layouts/Layout.astro";
import ProjectCard from "../../components/ui/ProjectCard.astro";
import projects from "../../constants/projects.json";
---

<Layout
  title="Projects • Siddarth Gundu"
  description="Projects and learning experiments across infrastructure, compilers, and developer tooling."
>
  <section class="project-page w-full">
    <header class="project-page__header mb-6 max-w-[43rem]">
      <h1 class="type-h1 m-0 text-balance text-title">
        Projects & Experiments
      </h1>
      <p class="type-m-500 m-0 mt-2 text-muted">
        A List of projects and learning experiments
      </p>
    </header>

    <div
      class="grid grid-cols-1 gap-x-8 sm:grid-cols-2"
      aria-label="Projects"
    >
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</Layout>
