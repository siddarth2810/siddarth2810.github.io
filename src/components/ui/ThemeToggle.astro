---
import { MdOutlineDarkMode, MdOutlineLightMode } from "react-icons/md";
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-label="Switch to dark theme"
  title="Switch theme"
>
  <MdOutlineDarkMode className="theme-toggle__moon" aria-hidden="true" />
  <MdOutlineLightMode className="theme-toggle__sun" aria-hidden="true" />
</button>
