---
import { RiArrowRightUpLine } from "react-icons/ri";
import { isExternalUrl } from "../../util/external-links";

type Project = {
  title: string;
  description: string;
  details?: string;
  tech: string[];
  link: string;
};

interface Props {
  project: Project;
  showDetails?: boolean;
}

const { project, showDetails = true } = Astro.props;
const isExternal = isExternalUrl(project.link);
---

<a
  class:list={["project-card", !showDetails && "project-card--compact"]}
  href={project.link}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener noreferrer" : undefined}
  aria-label={`View ${project.title}`}
>
  <RiArrowRightUpLine
    className="project-card__external-icon"
    aria-hidden="true"
  />

  <div class="project-card__body">
    <h3 class="project-card__title">{project.title}</h3>

    <p class="project-card__description">{project.description}</p>

    {
      showDetails && project.details && (
        <p class="project-card__details">{project.details}</p>
      )
    }

    <p class="project-card__tech">Tech: {project.tech.join(", ")}</p>
  </div>
</a>
