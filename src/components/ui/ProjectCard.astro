---
import Icon from "./Icon.astro";
import { isExternalUrl } from "../../util/url";

type Project = {
  title: string;
  description: string;
  details?: string;
  tech: string[];
  link: string;
};

interface Props {
  project: Project;
  showDetails?: boolean;
}

const { project, showDetails = true } = Astro.props;
const isExternal = isExternalUrl(project.link);
---

<a
  class:list={[
    "project-card relative flex w-full min-w-0 flex-col overflow-hidden",
    !showDetails && "project-card--compact",
  ]}
  href={project.link}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener noreferrer" : undefined}
  aria-label={`View ${project.title}`}
>
  <Icon
    name="arrow-up-right"
    class="project-card__external-icon absolute right-0 top-6 h-4 w-4"
  />

  <div class="project-card__body flex flex-col gap-2 pr-8">
    <h3 class="project-card__title type-m-600 m-0 text-title">
      {project.title}
    </h3>

    <p class="project-card__description type-s-500 m-0">
      {project.description}
    </p>

    {
      showDetails && project.details && (
        <p class="project-card__details type-s-500 m-0">{project.details}</p>
      )
    }

    <p class="project-card__tech type-s-500 m-0 mt-2">
      Tech: {project.tech.join(", ")}
    </p>
  </div>
</a>
