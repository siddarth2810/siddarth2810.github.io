---
import { MdOutlineKeyboardBackspace } from "react-icons/md";
import { withBase } from "../util/site-paths";
import ThemeToggle from "./ui/ThemeToggle.astro";

interface Props {
  isHomePage: boolean;
}

const { isHomePage } = Astro.props;

const navLinks = [
  { href: withBase("projects"), label: "projects" },
  { href: withBase("blogs"), label: "writings" },
  { href: withBase("reads"), label: "reads" },
];
---

<nav class="site-nav flex items-center justify-between pb-8 tracking-tight">
  <div class="site-nav__home">
    {
      isHomePage ? (
        <ThemeToggle />
      ) : (
        <a
          href={withBase("")}
          target="_self"
          class="hover:text-primary underline-offset-4 transition duration-150 ease-in-out hover:underline"
        >
          <MdOutlineKeyboardBackspace className="-mt-0.5 inline-block" />
          <span>home</span>
        </a>
      )
    }
  </div>

  <div class="site-nav__links flex items-center gap-4">
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          target="_self"
          class="hover:text-primary underline-offset-4 transition duration-150 ease-in-out hover:underline"
        >
          {link.label}
        </a>
      ))
    }

    {!isHomePage && <ThemeToggle />}
  </div>
</nav>
