---
import Icon from "./ui/Icon.astro";
import ThemeToggle from "./ui/ThemeToggle.astro";

interface Props {
  isHomePage: boolean;
}

const { isHomePage } = Astro.props;

const navLinks = [
  { href: "/opensource-log/", label: "oss" },
  { href: "/projects/", label: "projects" },
  { href: "/blogs/", label: "blog" },
  { href: "/reads/", label: "reads" },
];

const currentPath = Astro.url.pathname;
---

<nav
  class="site-nav flex items-center justify-between pb-8 tracking-tight"
  aria-label="Primary navigation"
>
  <div class="site-nav__home">
    {
      isHomePage ? (
        <ThemeToggle />
      ) : (
        <a
          href="/"
          class="hover:text-primary underline-offset-4 transition duration-150 ease-in-out hover:underline"
        >
          <Icon name="arrow-back" class="-mt-0.5 mr-1 inline-block" />
          <span>home</span>
        </a>
      )
    }
  </div>

  <div class="site-nav__links flex items-center gap-4">
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          aria-current={currentPath.startsWith(link.href) ? "page" : undefined}
          class="hover:text-primary underline-offset-4 transition duration-150 ease-in-out hover:underline"
        >
          {link.label}
        </a>
      ))
    }

    {!isHomePage && <ThemeToggle />}
  </div>

  <details class="site-nav__menu">
    <summary class="site-nav__menu-summary">
      <span>menu</span>
      <Icon name="arrow-down" class="site-nav__menu-icon" />
    </summary>
    <div class="site-nav__menu-panel">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={currentPath.startsWith(link.href) ? "page" : undefined}
            class="site-nav__menu-link hover:text-primary underline-offset-4 transition duration-150 ease-in-out hover:underline"
          >
            {link.label}
          </a>
        ))
      }

      {!isHomePage && <ThemeToggle />}
    </div>
  </details>
</nav>
